ANTHROPIC_API_KEY=sk-ant-...
NPO_DB_PATH=./data/npo.sqlite
NPO_DATA_RESIDENCY=ca-central
NPO_ADMIN_TOKEN=change-me-in-production

# QAgent (Node) — crawler + intelligence pipeline
# Anthropic models. Opus is used for vision, triage, and the hypothesis pass.
QAGENT_MODEL_OPUS=claude-opus-4-7
QAGENT_MODEL_SONNET=claude-sonnet-4-6
QAGENT_MODEL_HAIKU=claude-haiku-4-5-20251001
# Crawler defaults; CLI flags override.
QAGENT_MAX_DEPTH=2
QAGENT_MAX_ROUTES=40
QAGENT_NAV_TIMEOUT_MS=30000
QAGENT_USER_AGENT="QAgent/0.1 (+https://example.com/qagent)"
# Optional auth credentials (only used when --auth-mode=form or basic is set).
QAGENT_AUTH_USER=
QAGENT_AUTH_PASS=
