# TutorAgent environment — copy to .env and fill in.
# Any missing key logs a warning at boot naming the disabled feature; the server still starts.

ANTHROPIC_API_KEY=

# NocoDB (existing instance on DigitalOcean Toronto)
NOCODB_URL=
NOCODB_API_TOKEN=
NOCODB_BASE_ID=

# Weekly digest (Resend)
RESEND_API_KEY=
DIGEST_TO_EMAIL=
# Optional: verified sender, e.g. "TutorAgent <digest@yourdomain.ca>"
DIGEST_FROM_EMAIL=

# DigitalOcean Spaces (Toronto) — outline PDFs & work photos
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_BUCKET=
DO_SPACES_REGION=tor1

# Single-user login
APP_PASSPHRASE=

PORT=3000
