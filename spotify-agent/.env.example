# Copy this file to ".env" and fill in your own keys.
#   cp .env.example .env
#
# NEVER commit the real .env file — it's already in .gitignore.

# --- Anthropic ---
# Get one at https://console.anthropic.com/ -> Settings -> API Keys
ANTHROPIC_API_KEY=sk-ant-...

# --- Spotify ---
# Create an app at https://developer.spotify.com/dashboard
# then copy the Client ID and Client Secret from its settings.
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Must EXACTLY match a Redirect URI you added in the Spotify app settings.
# Spotify requires a loopback IP (127.0.0.1), not "localhost".
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
