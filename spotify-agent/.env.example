# Copy this file to ".env" and fill in your own keys.
#   cp .env.example .env
#
# NEVER commit the real .env file — it's already in .gitignore.

# --- Anthropic ---
# Get one at https://console.anthropic.com/ -> Settings -> API Keys
ANTHROPIC_API_KEY=sk-ant-...

# --- Spotify ---
# Create an app at https://developer.spotify.com/dashboard
# then copy the Client ID and Client Secret from its settings.
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Must EXACTLY match a Redirect URI you added in the Spotify app settings.
#   - CLI (agent.py):     http://127.0.0.1:8888/callback
#   - Web local (webapp): http://127.0.0.1:8000/callback
#   - Web deployed:       https://YOUR-APP-DOMAIN/callback
# Spotify requires a loopback IP (127.0.0.1) locally, not "localhost".
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/callback

# --- Web app only ---
# Secret used to sign session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=change-me-to-a-long-random-string

# Set to "production" when deployed so cookies are sent over HTTPS only.
ENV=development
