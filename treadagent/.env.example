# TreadAgent environment configuration
# Copy to .env and fill in. The service fails fast on startup if a
# required variable (marked REQUIRED below) is missing.

# --- NocoDB (DigitalOcean Toronto, Canadian data residency) ---
NOCODB_BASE_URL=https://your-nocodb-host.example.com     # REQUIRED
NOCODB_API_TOKEN=                                          # REQUIRED
NOCODB_BASE_ID=                                             # REQUIRED — the NocoDB base/project id

# --- Anthropic Claude API (drafting/summarization only, never math) ---
ANTHROPIC_API_KEY=                                          # REQUIRED
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MONTHLY_SPEND_CEILING_CAD=100                     # per-shop hard ceiling, fails closed

# --- Email (Resend) ---
RESEND_API_KEY=                                              # REQUIRED for live send
RESEND_WEBHOOK_SECRET=

# --- SMS (adapter: "console" for local dev, "twilio" for production) ---
SMS_ADAPTER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Stripe (CAD billing) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_RACK=
STRIPE_PRICE_SHOP=
STRIPE_PRICE_MULTI_SITE=

# --- DigitalOcean Spaces (file storage: tread photos, notices, evidence bundles) ---
SPACES_ENDPOINT=https://tor1.digitaloceanspaces.com
SPACES_REGION=tor1
SPACES_BUCKET=
SPACES_ACCESS_KEY_ID=
SPACES_SECRET_ACCESS_KEY=

# --- Make.com (inbound webhook shared secret for verifying calls into this service) ---
MAKE_WEBHOOK_SECRET=

# --- Service ---
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
