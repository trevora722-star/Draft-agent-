    "seed:demo": "node scripts/seed-demo-shop.js",
    "verify:ledger": "node scripts/verify-ledger.js",
    "print:rack-tags": "node scripts/print-rack-tags.js",
    "import:csv": "node scripts/import-csv.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "resend": "^4.0.0",
    "stripe": "^17.0.0",
    "twilio": "^5.3.0",
    "node-cron": "^3.0.3",
    "pdf-lib": "^1.17.1",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0"
  },
  "devDependencies": {}
}
