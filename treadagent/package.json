{
  "name": "treadagent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Multi-agent tire storage, tread-tracking, and seasonal changeover platform for Canadian tire shops.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test test/",
